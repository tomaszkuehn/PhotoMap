<Window x:Class="PhotoMapWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:PhotoMapWpf.Map"
        Title="PhotoMap"
        Width="1300" Height="840"
        MinWidth="720" MinHeight="500"
        Background="#0E1116"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- Flat button template: keeps our dark background in EVERY state
             (default WPF template paints disabled buttons light gray → white-on-white). -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#242B34"/>
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="52" Background="#151A21"
                    BorderBrush="#232B35" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="15" Height="15" Background="#2F7DF6" Margin="0,0,10,0"
                                CornerRadius="15,15,0,15" BorderBrush="White" BorderThickness="3"
                                VerticalAlignment="Center" RenderTransformOrigin="0,0">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-45"/>
                            </Border.RenderTransform>
                        </Border>
                        <TextBlock Text="PhotoMap" FontWeight="Bold" FontSize="15"
                                   Foreground="#E8ECF1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="SelCount" Text="Selected: 0" Foreground="#9AA7B4"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="ClearBtn" Content="Clear" Click="OnClearSelectionClick"
                                IsEnabled="False" Style="{StaticResource ToolButton}" Margin="0,0,8,0"/>
                        <Button x:Name="ExportBtn" Content="Export selected…" Click="OnExportSelectedClick"
                                IsEnabled="False" Style="{StaticResource ToolButton}" Background="#2F7DF6"
                                Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <Button x:Name="LinesBtn" Content="Lines: on" Click="OnLinesBtnClick"
                                IsEnabled="False" Style="{StaticResource ToolButton}" Margin="0,0,8,0"/>
                        <Button x:Name="OpenBtn" Content="Open folder…" Click="OnOpenFolderClick"
                                Style="{StaticResource ToolButton}" Background="#2F7DF6"
                                Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <map:MapControl x:Name="Map"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                        Background="#DD0D1117" BorderBrush="#2A3440" BorderThickness="1"
                        CornerRadius="8" Padding="10,7" IsHitTestVisible="False">
                    <TextBlock x:Name="Status" Foreground="#E8ECF1" FontSize="12.5"
                               Text="Pick a folder with geotagged photos — right-click (or Ctrl+click) a photo to select it"/>
                </Border>
            </Grid>
        </DockPanel>

        <Grid x:Name="Overlay" Visibility="Collapsed">
            <Border Background="#C7080A0E"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent">
                <Image x:Name="OvImg" Stretch="Uniform" StretchDirection="DownOnly"/>
                <Button x:Name="OvClose" Content="✕" Click="OnOvCloseClick"
                        Width="32" Height="32" HorizontalAlignment="Right"
                        Margin="0,-40,-8,0" Background="#24151A21" Foreground="White"
                        BorderThickness="0" Cursor="Hand" FontSize="14"/>
                <TextBlock x:Name="OvName" HorizontalAlignment="Center" Margin="0,10,0,0"
                           FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="OvMeta" HorizontalAlignment="Center" Margin="0,2,0,0"
                           Foreground="#9AA7B4" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>