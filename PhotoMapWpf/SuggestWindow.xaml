<Window x:Class="PhotoMapWpf.SuggestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trip suggestions"
        Width="1200" Height="820" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#12181F"
        PreviewKeyDown="OnWindowKeyDown"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#242B34"/>
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="BorderBrush" Value="#3A434F"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,8">
            <TextBlock Text="Location:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E8ECF1"/>
            <ComboBox x:Name="LocBox" Width="480" MinHeight="30"
                      SelectionChanged="OnLocChanged" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="LocInfo" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#9AA6B5"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="LoadBar" Grid.Row="0"
                         IsIndeterminate="True" Height="4" Margin="12,0,12,2"
                         Foreground="#2F7DF6" Background="#1F2733" BorderThickness="0"
                         Visibility="Collapsed"/>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Cards" Margin="10"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" Grid.Row="1"
                       Text="No catalog photos within 1 km of this location."
                       Foreground="#9AA6B5" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <DockPanel Grid.Row="2" Margin="12,4,12,12">
            <TextBlock x:Name="StatusT" DockPanel.Dock="Left" Text=""
                       Foreground="#9AA6B5" VerticalAlignment="Center"/>
            <Button x:Name="CopyBtn" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Content="Copy selected (0)" Style="{StaticResource ToolButton}"
                    Click="OnCopyClick" IsEnabled="False"/>
        </DockPanel>

        <Border x:Name="Enlarged" Grid.Row="0" Grid.RowSpan="3"
                Background="#CC10151B" Visibility="Collapsed"
                Cursor="Hand" MouseLeftButtonUp="OnEnlargedClick">
            <Image x:Name="EnlargedImg" Stretch="Uniform" Margin="14"/>
        </Border>
    </Grid>
</Window>